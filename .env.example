# JavaTutor 本地开发环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# .env 已在 .gitignore 中排除，不会提交

# ── 数据库（必填）─────────────────────────────────────────
# 本地 Docker: postgresql://postgres:local@127.0.0.1:5432/javatutor
# 如需 pgvector: 使用 pgvector/pgvector:pg16 镜像
PGDATABASE_URL=postgresql://postgres:local@127.0.0.1:5432/javatutor

# ── 模型端点（必填，L4 冒烟测试需要）─────────────────────
# Coze 平台值: https://integration.coze.cn/api/v3
COZE_INTEGRATION_MODEL_BASE_URL=https://integration.coze.cn/api/v3

# ── 模型鉴权（必填，L4 冒烟测试需要）─────────────────────
# 本地可用占位值；Coze 平台由 workload identity 注入
COZE_WORKLOAD_IDENTITY_API_KEY=placeholder

# ── 项目类型（必填）──────────────────────────────────────
# 固定为 agent，决定使用 AgentStreamRunner
COZE_PROJECT_TYPE=agent

# ── 环境标识（可选）──────────────────────────────────────
# 设为 DEV 启用 uvicorn hot-reload
COZE_PROJECT_ENV=DEV

# ── 日志目录（可选）──────────────────────────────────────
# 默认 /app/work/logs/bypass（平台值）；本地指向可写目录
COZE_LOG_DIR=.logs
