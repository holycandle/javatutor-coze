<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <!-- 图例 -->
  <text x="40" y="24" font-size="12" fill="#64748b">
    变量: {{ variable_name }} · 共 {{ step_count }} 步 · 蓝色 数组 · 红色 扫描指针
  </text>
{% if message %}
  <text x="40" y="60" font-size="14" fill="#ef476f">{{ message }}</text>
{% endif %}
  <!-- 柱状图 -->
{% for bar in bars %}
  <g>
    <rect id="bar-{{ bar.index }}" x="{{ bar.x }}" y="{{ bar.y }}" width="{{ bar.width }}" height="{{ bar.height }}" fill="#4f8cff">
      <title>{{ bar.value }}</title>
    </rect>
    <!-- 柱顶数值标注 -->
    <text x="{{ bar.x + bar.width / 2 }}" y="{{ bar.y - 6 }}" text-anchor="middle" font-size="11" fill="#1e293b" font-weight="600">{{ bar.value }}</text>
  </g>
{% endfor %}
  <!-- 底部索引 -->
{% for bar in bars %}
  <text x="{{ bar.x + bar.width / 2 }}" y="{{ 400 - 16 }}" text-anchor="middle" font-size="10" fill="#94a3b8">{{ bar.index }}</text>
{% endfor %}
  <!-- 扫描指针 -->
{% for scan in scans %}
  <rect x="{{ scan.x }}" y="40" width="4" height="320" fill="#ef476f" opacity="0">
    <animate attributeName="opacity" values="0;1;1;0" dur="0.6s" begin="{{ scan.begin }}s" repeatCount="1"/>
    <animate attributeName="fill" values="#ef476f;{{ '#06d6a0' if scan.found else '#ef476f' }};#ef476f" dur="0.6s" begin="{{ scan.begin }}s" repeatCount="1"/>
  </rect>
{% endfor %}
</svg>
