<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <!-- 图例 -->
  <text x="40" y="24" font-size="12" fill="#64748b">
    变量: {{ variable_name }} · 共 {{ step_count }} 步 · 蓝色 默认 · 黄色 比较/交换
  </text>
{% if message %}
  <text x="40" y="60" font-size="14" fill="#ef476f">{{ message }}</text>
{% endif %}
  <!-- 柱状图 -->
{% for bar in bars %}
  <g>
    <rect id="bar-{{ bar.index }}" x="{{ bar.x }}" y="{{ bar.y }}" width="{{ bar.width }}" height="{{ bar.height }}" fill="#4f8cff">
      <title>{{ bar.value }}</title>
{% for move in move_groups[bar.index] %}
      <animate attributeName="x" from="{{ move.from_x }}" to="{{ move.to_x }}" dur="0.4s" begin="{{ move.begin }}s" fill="freeze"/>
{% endfor %}
{% for hl in highlight_groups[bar.index] %}
      <animate attributeName="fill" values="#4f8cff;#ffd166;#4f8cff" dur="0.4s" begin="{{ hl.begin }}s" repeatCount="1"/>
{% endfor %}
    </rect>
    <!-- 柱顶数值标注（跟随柱子移动） -->
    <text x="{{ bar.x + bar.width / 2 }}" y="{{ bar.y - 6 }}" text-anchor="middle" font-size="11" fill="#1e293b" font-weight="600">{{ bar.value }}
{% for move in move_groups[bar.index] %}
      <animate attributeName="x" from="{{ move.from_x + bar.width / 2 }}" to="{{ move.to_x + bar.width / 2 }}" dur="0.4s" begin="{{ move.begin }}s" fill="freeze"/>
{% endfor %}
    </text>
  </g>
{% endfor %}
  <!-- 底部索引 -->
{% for bar in bars %}
  <text x="{{ bar.x + bar.width / 2 }}" y="{{ 400 - 16 }}" text-anchor="middle" font-size="10" fill="#94a3b8">{{ bar.index }}</text>
{% endfor %}
</svg>
