<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <!-- 标题 -->
{% if variable_name %}
  <text x="40" y="24" font-size="12" fill="#64748b">变量: {{ variable_name }} · DP 表 · {{ cells|length }} 格 · 共 {{ step_count }} 步</text>
{% endif %}
{% if message %}
  <text x="40" y="60" font-size="14" fill="#ef476f">{{ message }}</text>
{% endif %}
  <!-- 单元格 -->
{% for cell in cells %}
  <rect id="cell-{{ cell.row }}-{{ cell.col }}" x="{{ cell.x }}" y="{{ cell.y }}" width="{{ cell.width }}" height="{{ cell.height }}" fill="#e2e8f0" stroke="#64748b">
    <title>{{ cell.value }}</title>
{% for hl in highlight_groups[cell.key] %}
    <animate attributeName="fill" values="#e2e8f0;#ffd166;#e2e8f0" dur="0.6s" begin="{{ hl.begin }}s" repeatCount="1"/>
{% endfor %}
  </rect>
  <text x="{{ cell.cx }}" y="{{ cell.cy }}" text-anchor="middle" dominant-baseline="central" font-size="12" font-weight="600" fill="#1e293b">{{ cell.value }}</text>
{% endfor %}
  <!-- 列索引 -->
{% for cell in cells %}
{% if cell.row == 0 %}
  <text x="{{ cell.cx }}" y="{{ cell.y - 4 }}" text-anchor="middle" font-size="9" fill="#94a3b8">[{{ cell.col }}]</text>
{% endif %}
{% endfor %}
</svg>
